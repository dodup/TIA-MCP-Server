{"name":"hmi_create_tag","description":"Create or update an HMI tag linked to a PLC tag with connection name and table.","parameters":{"additionalProperties":false,"properties":{"connection":{"description":"HMI connection name (default: 'HMI_Connection_1').","type":"string"},"plc_tag":{"description":"PLC tag path (e.g. 'DB_MixingLine.Line.MotorInfeed.RunFb').","type":"string"},"table_name":{"description":"Tag table name (default: 'Default tag table').","type":"string"},"tag_name":{"description":"HMI Tag name.","type":"string"},"target_name":{"description":"Target HMI software name (optional).","type":"string"}},"required":["tag_name","plc_tag"],"type":"object"}}