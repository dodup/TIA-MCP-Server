<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TiaOpennessMcp</AssemblyName>
    <RootNamespace>TiaOpennessMcp</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyVersion>0.0.2.0</AssemblyVersion>
    <FileVersion>0.0.2.0</FileVersion>
    <Version>0.0.2</Version>
  </PropertyGroup>

  <!--
    Resolve Siemens assemblies:
    1. First check local TIA Portal installation paths (if present)
    2. Fall back to bundled reference assemblies in $(MSBuildProjectDirectory)\lib
    CopyLocal (Private=True) ensures all runtime dependencies are bundled with the executable.
  -->
  <PropertyGroup>
    <SiemensPublicApiDir Condition="'$(SiemensPublicApiDir)' == '' and Exists('C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Base.dll')">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</SiemensPublicApiDir>
    <SiemensPublicApiDir Condition="'$(SiemensPublicApiDir)' == ''">$(MSBuildProjectDirectory)\lib</SiemensPublicApiDir>

    <PlcSimApiDir Condition="'$(PlcSimApiDir)' == '' and Exists('C:\Program Files (x86)\Common Files\Siemens\PLCSIMADV\API\8.0\Siemens.Simatic.Simulation.Runtime.Api.x64.dll')">C:\Program Files (x86)\Common Files\Siemens\PLCSIMADV\API\8.0</PlcSimApiDir>
    <PlcSimApiDir Condition="'$(PlcSimApiDir)' == ''">$(MSBuildProjectDirectory)\lib</PlcSimApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath Condition="Exists('$(SiemensPublicApiDir)\Siemens.Engineering.Base.dll')">$(SiemensPublicApiDir)\Siemens.Engineering.Base.dll</HintPath>
      <HintPath Condition="!Exists('$(SiemensPublicApiDir)\Siemens.Engineering.Base.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Engineering.Base.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath Condition="Exists('$(SiemensPublicApiDir)\Siemens.Engineering.Step7.dll')">$(SiemensPublicApiDir)\Siemens.Engineering.Step7.dll</HintPath>
      <HintPath Condition="!Exists('$(SiemensPublicApiDir)\Siemens.Engineering.Step7.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Engineering.Step7.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCC">
      <HintPath Condition="Exists('$(SiemensPublicApiDir)\Siemens.Engineering.WinCC.dll')">$(SiemensPublicApiDir)\Siemens.Engineering.WinCC.dll</HintPath>
      <HintPath Condition="!Exists('$(SiemensPublicApiDir)\Siemens.Engineering.WinCC.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Engineering.WinCC.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified">
      <HintPath Condition="Exists('$(SiemensPublicApiDir)\Siemens.Engineering.WinCCUnified.dll')">$(SiemensPublicApiDir)\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <HintPath Condition="!Exists('$(SiemensPublicApiDir)\Siemens.Engineering.WinCCUnified.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.TestSuite">
      <HintPath Condition="Exists('$(SiemensPublicApiDir)\Siemens.Engineering.TestSuite.dll')">$(SiemensPublicApiDir)\Siemens.Engineering.TestSuite.dll</HintPath>
      <HintPath Condition="!Exists('$(SiemensPublicApiDir)\Siemens.Engineering.TestSuite.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Engineering.TestSuite.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Siemens.Simatic.Simulation.Runtime.Api">
      <HintPath Condition="Exists('$(PlcSimApiDir)\Siemens.Simatic.Simulation.Runtime.Api.x64.dll')">$(PlcSimApiDir)\Siemens.Simatic.Simulation.Runtime.Api.x64.dll</HintPath>
      <HintPath Condition="!Exists('$(PlcSimApiDir)\Siemens.Simatic.Simulation.Runtime.Api.x64.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Simatic.Simulation.Runtime.Api.x64.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
